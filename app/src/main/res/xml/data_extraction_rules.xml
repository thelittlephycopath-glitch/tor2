<?xml version="1.0" encoding="utf-8"?>
<!-- Explicitly keep the opt-in network-learning store local to this installation. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="autonomy_network_learning_v1.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="autonomy_network_learning_v1.xml" />
    </device-transfer>
</data-extraction-rules>
